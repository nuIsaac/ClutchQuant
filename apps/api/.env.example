APP_ENV=development
# DATABASE_URL is mandatory outside development. Supply it through your shell,
# deployment secret store, or an explicit environment-file loader.
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE
# ARTIFACT_ROOT=/durable/path/clutchquant-artifacts
# HUMAN_FORECAST_TOKEN is optional; production writes are disabled without it.
# Optional authorized THESPIKE upcoming JSON export (worker only).
# No scraping is enabled. Refresh this file at least every 15 minutes.
# THESPIKE_EXPORT_PATH=/authorized-data/thespike-upcoming.json
