# Copy to deploy/.env.production (ignored); chmod 600. Never print resolved config.
COMPOSE_PROJECT_NAME=clutchquant-production
RELEASE_TAG=replace-with-reviewed-commit
CADDY_SITE=quant.example.com
ACME_EMAIL=operator@example.com
# Generate two independent values: openssl rand -hex 32
POSTGRES_PASSWORD=replace-with-64-hex-characters
APP_DB_PASSWORD=replace-with-different-64-hex-characters
DATA_DIR=/srv/clutchquant
WORKER_INTERVAL_SECONDS=300
WORKER_PAGES=1
