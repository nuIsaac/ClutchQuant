# Server-only; copy to deploy/.env.demo, never commit the populated copy.
APP_ENV=production
# Supabase SESSION pooler, port 5432; percent-encode password characters.
DATABASE_URL=postgresql+psycopg://postgres.PROJECT_REF:ENCODED_PASSWORD@POOLER_HOST:5432/postgres?sslmode=require
DB_POOL_SIZE=2
DB_MAX_OVERFLOW=0
ARTIFACT_BACKEND=supabase
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_SERVER_ONLY_LEGACY_SERVICE_ROLE_JWT
SUPABASE_ARTIFACT_BUCKET=clutchquant-artifacts
# Set true on Render; false for the scheduled collector.
ARTIFACT_READ_ONLY=false
